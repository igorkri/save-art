[mysqld]
# Memory settings
sort_buffer_size = 64M
read_buffer_size = 8M
read_rnd_buffer_size = 8M
join_buffer_size = 8M
tmp_table_size = 128M
max_heap_table_size = 128M

# Performance settings
innodb_buffer_pool_size = 512M
innodb_sort_buffer_size = 64M

# Query cache (если поддерживается)
max_sort_length = 8192

