{
    "openapi": "3.0.0",
    "info": {
        "title": "Art-UA Marketplace API",
        "description": "API для маркетплейсу мистецтва art-ua.com — купівля та продаж творів мистецтва",
        "contact": {
            "name": "Art-UA Support",
            "email": "support@art-ua.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://art-ua.com/api/v1",
            "description": "Production Server"
        },
        {
            "url": "http://art-ua.local/api/v1",
            "description": "Local Development"
        }
    ],
    "paths": {
        "/info": {
            "get": {
                "tags": [
                    "Info"
                ],
                "summary": "Інформація про Art-UA Marketplace API",
                "description": "Повертає загальну інформацію про API та його можливості",
                "operationId": "artUaGetInfo",
                "responses": {
                    "200": {
                        "description": "Інформація про API",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "example": "Art-UA Marketplace API"
                                        },
                                        "version": {
                                            "type": "string",
                                            "example": "1.0.0"
                                        },
                                        "description": {
                                            "type": "string",
                                            "example": "API для маркетплейсу мистецтва art-ua.com"
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "active"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Info",
            "description": "Загальна інформація про API"
        }
    ],
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Laravel Sanctum Bearer Token. Формат: Bearer <token>",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            },
            "apiKey": {
                "type": "apiKey",
                "description": "API ключ для доступу до API. Передається у заголовку X-Api-Key.",
                "name": "X-Api-Key",
                "in": "header"
            }
        }
    },
    "security": [
        {
            "apiKey": []
        }
    ]
}